<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent keeping the wireless cache warm on macOS.
     cp to ~/Library/LaunchAgents/ and: launchctl load -w <file> -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gatework.wireless-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/wireless</string>
    <string>watch</string>
    <string>--interval</string><string>2m</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/wireless-watch.log</string>
</dict>
</plist>
